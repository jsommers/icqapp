<%= turbo_frame_tag 'attendance_checkin' do %>
  <div class="floating-card mb-4 border-start border-4 <%= course.attendance_active? ? 'border-success' : 'border-secondary' %>">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <div class="<%= course.attendance_active? ? 'bg-success' : 'bg-secondary' %> p-2 rounded-circle me-3">
          <%= octicon "check-circle", class: "text-white", height: 20 %>
        </div>
        <div>
          <h4 class="h6 fw-bold mb-0 text-primary">Attendance</h4>
          <span class="small text-muted">
            <% if course.attendance_active? %>
              Attendance check-in is open.
            <% else %>
              Attendance check-in is not open right now.
            <% end %>
          </span>
        </div>
      </div>
      
      <% if course.attendance_active? %>
        <% if checked_in %>
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
            <%= octicon "check", class: "me-1" %> You're checked in for today
          </span>
        <% else %>
          <%= button_to "Attendance check-in", attendance_check_in_path(course), class: "btn btn-success px-4 fw-bold shadow-sm" %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
