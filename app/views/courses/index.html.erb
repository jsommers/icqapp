<div class="mb-5">
  <h1 class="fw-extrabold text-primary mb-1">My Courses</h1>
  <p class="text-muted">Welcome back! Here are the courses you are currently involved in.</p>
</div>

<div class="row g-4">
  <% @courses.each do |c| %>
    <div class="col-12 col-md-6 col-xl-4">
      <div class="floating-card h-100 d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <h3 class="h4 fw-bold mb-0">
            <%= link_to c.name, course_path(c), class: "text-primary text-decoration-none" %>
          </h3>
          <% if c.now? %>
            <span class="badge-status active">Live Now</span>
          <% end %>
        </div>

        <div class="mb-4">
          <div class="d-flex align-items-center text-muted small mb-2">
            <%= octicon "calendar", class: "me-2", height: 16 %>
            <%= c.daytime %>
          </div>
          <% if !current_user.student? %>
            <div class="d-flex align-items-center text-muted small">
              <%= octicon "people", class: "me-2", height: 16 %>
              <%= pluralize(c.students.count, "student") %>
            </div>
          <% end %>
        </div>

        <% if !current_user.student? %>
          <div class="mt-auto pt-3 border-top d-flex gap-3 flex-wrap">
            <%= link_to course_path(c), class: "btn btn-link btn-sm p-0 text-decoration-none text-primary d-flex align-items-center fw-bold" do %>
              <%= octicon "eye", class: "me-1", height: 14 %> View Course
            <% end %>
            <%= link_to attendance_report_path(c), class: "btn btn-link btn-sm p-0 text-decoration-none text-muted d-flex align-items-center" do %>
              <%= octicon "check-circle", class: "me-1", height: 14 %> Attendance
            <% end %>
            <%= link_to question_report_path(c), class: "btn btn-link btn-sm p-0 text-decoration-none text-muted d-flex align-items-center" do %>
              <%= octicon "graph", class: "me-1", height: 14 %> Polls
            <% end %>
            <%= link_to course_cold_calls_path(c), class: "btn btn-link btn-sm p-0 text-decoration-none text-muted d-flex align-items-center" do %>
              <%= octicon "megaphone", class: "me-1", height: 14 %> Cold Calls
            <% end %>
          </div>
        <% else %>
           <div class="mt-auto pt-3 border-top">
             <%= link_to "Enter Course", course_path(c), class: "btn btn-primary btn-sm w-100 fw-bold" %>
           </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
