<div class="row">
  <div class="col"><%= @coldcall.user.email %></div>
  <div class="col"><%= @coldcall.count %></div>
  <div class="col">
    <%= turbo_frame_tag dom_id(@coldcall) do %>
      <%= form_with model: [@course, @coldcall], local: true do |form| %>
        <%= form.number_field :count %>
        <%= form.submit "Save" %>
      <% end %>
    <% end %>
  </div>
</div>
