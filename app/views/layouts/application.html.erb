<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>icqapp</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </head>
  <body>
    <% if user_signed_in? %>
      <header class="navbar-colgate">
        <div class="container-xl d-flex align-items-center justify-content-between px-3">
          <div class="d-flex align-items-center">
            <%= link_to courses_path, class: "text-decoration-none me-4" do %>
              <h1 class="text-white fw-bold mb-0 h3">icq<span class="text-white-50">app</span></h1>
            <% end %>
            <nav class="d-none d-md-flex">
              <%= link_to courses_path, class: "text-white-50 text-decoration-none small fw-bold" do %>
                <%= octicon "home", class: "me-1", height: 16 %> Dashboard
              <% end %>
            </nav>
          </div>

          <div class="d-flex align-items-center gap-3">
            <div class="text-white-50 small d-none d-sm-block">
              <%= current_user.email %>
            </div>
            <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-sm btn-outline-light d-flex align-items-center", data: { turbo: false } do %>
              <%= octicon "sign-out", class: "me-1", height: 14 %> Sign out
            <% end %>
          </div>
        </div>
      </header>
    <% end %>

    <main class="main-content">
      <div id="jsflash"></div>
      <%= render partial: 'common/flash' %>
      <%= yield %>
    </main>
  </body>
</html>
