<%= turbo_stream.replace 'flash' do %>
  <%= render partial: 'common/flash' %>
<% end %>

<%= turbo_stream.append 'question_list' do %>
  <%= render partial: 'question', locals: {question: @question} %>
<% end %>

<%= turbo_stream.replace 'create_form' do %>
  <%= turbo_frame_tag 'create_form', target: "_top" do %>
    <%= link_to new_course_question_path(@course), class: "btn btn-primary d-flex align-items-center shadow-sm" do %>
      <%= octicon "plus", class: "me-2", height: 16 %> Create a new question
    <% end %>
  <% end %>
<% end %>
