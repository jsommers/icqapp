<div class="mb-5 d-flex justify-content-between align-items-end">
  <div>
    <h1 class="fw-extrabold text-primary mb-1"><%= @course.name %></h1>
    <p class="text-muted"><%= @course.daytime %> &bull; Students enrolled: <%= @course.students.count %></p>
  </div>
  
  <div class="d-flex gap-2">
    <% if !@course.attendance_taken? %>
      <%= button_to open_attendance_path(@course), class: 'btn btn-success d-flex align-items-center shadow-sm' do %>
        <%= octicon "check", class: "me-2", height: 16 %> Take attendance
      <% end %>
    <% else %>
      <% if @course.attendance_active? %>
        <%= button_to close_attendance_path(@course), class: 'btn btn-warning d-flex align-items-center shadow-sm' do %>
          <%= octicon "x-circle", class: "me-2", height: 16 %> Close attendance
        <% end %>
      <% else %>
        <%= button_to open_attendance_path(@course), class: 'btn btn-outline-success d-flex align-items-center' do %>
          <%= octicon "sync", class: "me-2", height: 16 %> Reopen attendance
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="mb-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Questions</h2>
    <%= turbo_frame_tag 'create_form', target: "_top" do %>
      <%= link_to new_course_question_path(@course), class: "btn btn-primary d-flex align-items-center shadow-sm" do %>
        <%= octicon "plus", class: "me-2", height: 16 %> Create a new question
      <% end %>
    <% end %>
  </div>

  <div id="question_list" class="row g-3">
    <%= render partial: 'question', collection: @questions %>
  </div>
</div>
